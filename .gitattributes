# Normalize line endings. `core.autocrlf=true` on Windows gives the working tree
# CRLF, which makes `gofmt -l` report every Go file as unformatted even though
# the committed content is fine. Pin the tools' native endings explicitly.
* text=auto

*.go     text eol=lf
go.mod   text eol=lf
go.sum   text eol=lf
*.py     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.md     text eol=lf
*.toml   text eol=lf

# Shell scripts and the external builder must keep LF endings: a CR before
# `pipefail` makes bash reject the option, and Fabric execs the builder directly.
*.sh text eol=lf
scripts/fabric/external_builder/bin/* text eol=lf
