# ─── Sensitive data (NEVER commit — see CLAUDE.md §7) ───────────────────────
# Real DAIC-WOZ data must never enter the repo. Only mock data is allowed,
# and even that is regenerated on demand rather than committed.
data/*
!data/.gitkeep
!data/README.md

# Raw media, wherever it appears
*.wav
*.mp4
*.avi
*.mov

# Tabular data is only sensitive under data/ — a global `*.csv` rule would also
# silently swallow the Chapter-4 result tables, so scope it.
data/**/*.csv

# ─── Secrets ────────────────────────────────────────────────────────────────
.env
*.pem
*.key
*.crt
fabric-keys/

# ─── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ─── Experiment outputs ─────────────────────────────────────────────────────
# The small result files ARE the evidence behind every number in docs/architecture,
# and the GPU box they were produced on has no persistent volume — a recycle
# deletes them. They are aggregate metrics plus the config that produced them, hold
# no participant identifiers, and cost a few MB, so they are kept. Checkpoints are
# not: they are large and reproducible from the committed config.
experiments/*
!experiments/.gitkeep
!experiments/**/
!experiments/**/*.json
!experiments/**/*.jsonl
!experiments/**/*.yaml
!experiments/**/*.png
!experiments/**/*.md
experiments/**/*.pt

# ─── Go / chaincode build output ────────────────────────────────────────────
chaincode/**/*.exe
chaincode/**/privchain-cc

# ─── Notebooks scratch ──────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Editors / OS ───────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db

